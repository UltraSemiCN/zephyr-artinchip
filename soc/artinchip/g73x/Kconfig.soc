config SOC_SERIES_G73X
	bool
	select SOC_FAMILY_ARTINCHIP

config SOC_SERIES
	default "g73x" if SOC_SERIES_G73X

config SOC_G73X
	bool
	select SOC_SERIES_G73X

config SOC
	default "g73x" if SOC_G73X
