config SOC_SERIES_D11X
	bool
	select SOC_FAMILY_ARTINCHIP

config SOC_SERIES
	default "d11x" if SOC_SERIES_D11X

config SOC_D11X
	bool
	select SOC_SERIES_D11X

config SOC
	default "d11x" if SOC_D11X
