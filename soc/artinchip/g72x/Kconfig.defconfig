if SOC_SERIES_G72X

config NUM_IRQS
	default 128

config ARCH_SW_ISR_TABLE_ALIGN
	default 64

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0x3FF

choice CACHE_TYPE
	default ARCH_CACHE
endchoice

config RISCV_ISA_EXT_XTHEAD_CMO
	default y

config RISCV_CUSTOM_CSR_THEAD_CMO
	default y

config RISCV_CUSTOM_CSR_THEAD_CMO_E907
	default y

endif # SOC_SERIES_G72X
