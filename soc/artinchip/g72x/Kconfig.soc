config SOC_SERIES_G72X
	bool
	select SOC_FAMILY_ARTINCHIP

config SOC_SERIES
	default "g72x" if SOC_SERIES_G72X

config SOC_G72X
	bool
	select SOC_SERIES_G72X

config SOC
	default "g72x" if SOC_G72X
