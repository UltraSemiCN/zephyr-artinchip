config SOC_SERIES_D21X
	bool
	select SOC_FAMILY_ARTINCHIP

config SOC_SERIES
	default "d21x" if SOC_SERIES_D21X

config SOC_D21X
	bool
	select SOC_SERIES_D21X

config SOC
	default "d21x" if SOC_D21X
