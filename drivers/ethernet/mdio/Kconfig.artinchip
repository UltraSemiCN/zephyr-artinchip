config MDIO_ARTINCHIP
	bool "ArtInChip GMAC MDIO controller"
	default y
	depends on DT_HAS_ARTINCHIP_D13X_MDIO_ENABLED
	select RESET
	help
	  Enable Clause 22 MDIO access through the ArtInChip GMAC.
