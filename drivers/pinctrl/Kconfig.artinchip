config PINCTRL_ARTINCHIP
	bool "ArtInChip pin controller"
	default y
	depends on DT_HAS_ARTINCHIP_PINCTRL_ENABLED
	help
	  Enable pin function, pull resistor, and drive strength configuration
	  for ArtInChip SoCs.
