config MEMC_ARTINCHIP_XSPI
	bool "ArtInChip XSPI memory controller"
	default y
	depends on DT_HAS_ARTINCHIP_D13X_XSPI_ENABLED
	depends on CLOCK_CONTROL
	depends on RESET
	help
	  Validate and preserve the XSPI PSRAM configuration inherited from
	  the ArtInChip pre-boot firmware.
