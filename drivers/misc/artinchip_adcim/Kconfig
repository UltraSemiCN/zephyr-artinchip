config ARTINCHIP_ADCIM
	bool "ArtInChip ADC interface manager"
	default y
	depends on DT_HAS_ARTINCHIP_D13X_ADCIM_ENABLED
	depends on CLOCK_CONTROL && RESET
	help
	  Enable the shared ADC calibration interface used by ArtInChip analog
	  peripherals.

config ARTINCHIP_ADCIM_INIT_PRIORITY
	int "ADC interface manager init priority"
	default 49
	depends on ARTINCHIP_ADCIM
	help
	  Initialize ADCIM before ADC consumers, whose default priority is 50.
