config DMA_ARTINCHIP
	bool "ArtInChip DMA driver"
	default y
	depends on DT_HAS_ARTINCHIP_D13X_DMA_ENABLED
	help
	  Enable the ArtInChip DMA controller driver used by UART and
	  other peripherals.
