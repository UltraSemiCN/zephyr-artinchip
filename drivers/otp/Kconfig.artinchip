config OTP_ARTINCHIP
	bool "ArtInChip eFuse"
	default y
	depends on DT_HAS_ARTINCHIP_D13X_EFUSE_ENABLED
	depends on CLOCK_CONTROL && RESET
	help
	  Enable read-only access to the ArtInChip eFuse/SID block.
